<?xml version="1.0" encoding="utf-8"?>
<!--
  Configure a private NuGet feed used to restore packages when building .NET LSTs.
  Uncomment and update the entries below as needed, then point publish.ps1 at this
  file with NUGET_CONFIG_FILE (see .env.example). It is copied to the user-level
  %APPDATA%\NuGet\NuGet.Config so both the NuGet CLI (.NET Framework / packages.config)
  and dotnet restore (SDK-style projects) pick it up during `mod build`.
-->
<configuration>
  <packageSources>
    <!-- Clear the inherited defaults if you must restore exclusively from a private feed -->
    <!-- <clear /> -->

    <!-- Your private feed (e.g. Artifactory / Azure Artifacts / GitHub Packages) -->
    <!-- <add key="internal" value="https://your-private-registry.example.com/nuget/v3/index.json" /> -->

    <!-- The public gallery (keep unless your policy forbids it) -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Authentication for the private feed (choose one) -->
  <!--
  <packageSourceCredentials>
    <internal>
      <add key="Username" value="%NUGET_USER%" />
      <add key="ClearTextPassword" value="%NUGET_PASSWORD%" />
    </internal>
  </packageSourceCredentials>
  -->
</configuration>
