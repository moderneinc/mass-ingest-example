# ==============================================================================
# Mass-ingest configuration
# Copy this file to 2-observability/.env and fill in the values below before
# running 'docker compose up'. The same variables work with a plain 'docker run'.
# ==============================================================================

# ==============================================================================
# ARTIFACT REPOSITORY (Required — choose one option)
# ==============================================================================
# The store holds two files: repos.csv is the input, which your repository fetcher
# overwrites whole whenever membership changes and never merges; repos-lock.csv is the
# output, rebuilt from repos.csv by `mod publish` and written by nothing else.

# Option A: Nexus / Artifactory / Maven repository (username + password)
PUBLISH_URL=https://nexus.example.com/repository/moderne-ingest/
PUBLISH_USER=your-username
PUBLISH_PASSWORD=your-password

# Option B: Artifactory (API token — alternative to username/password above)
# PUBLISH_URL=https://artifactory.example.com/artifactory/moderne-ingest/
# PUBLISH_TOKEN=your-jfrog-api-token

# Option C: S3 bucket (see docs/s3.md)
# PUBLISH_URL=s3://your-bucket                          # bucket only; the CLI rejects a key prefix
# S3_PROFILE=default                                    # Optional: AWS profile name
# S3_REGION=us-west-2                                   # Optional: For cross-region access
# S3_ENDPOINT=https://minio.example.com                 # Optional: S3-compatible services
# AWS_REGION=us-east-1                                  # Optional: Explicit region for AWS SDK
#
# Note: On EC2 with IAM roles, Docker adds a network hop, so you must set the
# IMDSv2 hop limit to 2. See docs/s3.md for details.

# ==============================================================================
# SCM CREDENTIALS (Required for private repositories)
# ==============================================================================

# Option A: HTTPS credentials (inline, alternative to volume-mounting .git-credentials)
# GIT_CREDENTIALS=https://username:token@bitbucket.example.com

# Option B: SSH private key (inline, alternative to volume-mounting .ssh/)
# GIT_SSH_CREDENTIALS=-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----

# When using volume mounts instead, uncomment the relevant lines in docker-compose.yml

# ==============================================================================
# MODERNE PLATFORM (Optional — connects LSTs to a Moderne tenant)
# ==============================================================================

# MODERNE_TENANT=https://app.moderne.io
# MODERNE_TOKEN=your-moderne-token

# ==============================================================================
# INGESTION TUNING (Optional)
# ==============================================================================

# Ingest a single organization from the store's repos.csv (default: everything).
# Run one container per organization to spread the work.
# ORGANIZATION=Payments

# Repositories in flight at once inside one container (default: 1)
# PARALLEL=2

# ==============================================================================
# .NET / C# BUILDS (Optional — Windows/PowerShell publish.ps1 only)
# ==============================================================================
# On Windows, building .NET LSTs needs only the NuGet CLI (no Mono) plus .NET SDK
# 10.0+, and cleanly restores both .NET Framework (packages.config) and .NET Core
# (SDK-style) projects. Building .NET is driven by the `dotnet` build step in
# moderne.yml (enabled by default) — no runtime flag is required.

# Optional private-feed NuGet config applied to %APPDATA%\NuGet\NuGet.Config at runtime
# NUGET_CONFIG_FILE=nuget/nuget.config

# ==============================================================================
# DIAGNOSTICS (Optional)
# ==============================================================================

# Run `mod doctor` only (no ingestion); the container exits non-zero when a check fails
# DIAGNOSE=true

# Run `mod doctor` before ingestion starts, and ingest regardless of the result
# DIAGNOSE_ON_START=true

# ==============================================================================
# CLI VERSION (Optional — set as Docker build arg, not runtime env)
# ==============================================================================

# Pin a specific Moderne CLI version (defaults to latest release)
# MODERNE_CLI_VERSION=4.9.0
